# install-apps.sh configuration.
#
# Copy this file to install-apps.conf (same directory) and edit the
# value for your system, then run install-apps.sh. install-apps.conf is
# gitignored, so local edits won't conflict with a future update to the
# script itself.

# Base directory the mkdc helper function (appended to the invoking
# user's ~/.bashrc) creates/opens Docker Compose project directories
# under, e.g. `mkdc myproject` -> $HOMELAB_ROOT/myproject.
HOMELAB_ROOT="/media/william/NewData/homelab"
