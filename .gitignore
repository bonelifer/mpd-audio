# OS
.DS_Store
Thumbs.db

# Editors
*.swp
*.swo
*~

# Local environment/secrets
.env

# Shared script configuration (paths/versions edited per-machine) -
# copy mpd-audio.conf.example to mpd-audio.conf and edit it
mpd-audio.conf

# install-docker.sh's mkdc setting - either self-created from the
# interactive prompt on first run, or copied from
# install-docker.conf.example ahead of time
install-docker.conf

# Generated by generate-mpd-conf.sh (mpd.conf here is a checked-in sample;
# ignore only if you intentionally regenerate it locally and don't want to
# commit machine-specific output)
mpd.conf

# Desloppify scan output (see ~/.claude/CLAUDE.md)
.desloppify/
